# 复制为 .env 后填写真实值（红线8：真实 .env 不进 git）
# MySQL（本机开发 root/1234）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DB=medical_agent

# 阿里云百炼
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# Neo4j（infra/docker-compose.yml 默认账号，宿主端口 7688/7475）
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j1234

# Qdrant（宿主端口 6335/6336）
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6335

# JWT（M6）
JWT_SECRET=
JWT_EXPIRE_HOURS=24
